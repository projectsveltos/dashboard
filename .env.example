# The port number on which the backend server is running
VITE_BACKEND_PORT=80

# The IP address or hostname of the backend server
VITE_BACKEND_NAME=ip-212-2-246-128.eu

# The timeout duration (in milliseconds) for API requests
VITE_API_TIMEOUT=5000
#  Version Number
VITE_APP_VERSION=versionNumber

# OIDC authentication (optional — leave unset to use manual token authentication)
# Issuer URL of your OIDC provider
VITE_OIDC_ISSUER=
# Client ID registered with your OIDC provider
VITE_OIDC_CLIENT_ID=
# Redirect URI after OIDC login (defaults to <origin>/oidc-callback if unset)
VITE_OIDC_REDIRECT_URI=
# Scope requested during OIDC login (defaults to "openid profile email offline_access" if unset).
# Override this when your provider must issue an access token audienced to a specific resource,
# e.g. AKS with Microsoft Entra ID authorization requires the AKS server app's scope included here.
VITE_OIDC_SCOPE=

